{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s2X3",
  "version": "0.0.1",
  "identifier": "dev.s2x3.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "s2X3 \u00b7 SSX 3 launcher",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
